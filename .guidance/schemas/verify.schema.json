  "additionalProperties": false,
  "required": [
    "verificationSummary"
  ],
  "properties": {
    "verificationSummary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skippedChecks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptedCriteriaEvidence": {
