#!/usr/bin/env python3
"""Summarize per-frame draw durations logged by Zed.

Run Zed with `ZED_MEASUREMENTS=1` and its stderr redirected to a file; every drawn frame
logs `frame duration: <duration>`. Then:

    script/frame-times frames-main.log frames-branch.log

prints, per log, the frame count and the p50 / p90 / p95 / p99 / max draw durations, plus
how many frames exceeded one 120 Hz (8.3 ms) and one 60 Hz (16.7 ms) frame budget. With two
or more logs it also prints the change of each statistic relative to the first log.

See crates/gpui/docs/view_tree.md, "Real use", for the session to drive.
"""

import re
import sys

DURATION = re.compile(r"frame duration: ([0-9.]+)(ns|µs|us|ms|s)\b")
UNITS_TO_MS = {"ns": 1e-6, "µs": 1e-3, "us": 1e-3, "ms": 1.0, "s": 1e3}
PERCENTILES = (50, 90, 95, 99)
BUDGETS_MS = (8.3, 16.7)


def read_durations_ms(path):
    durations = []
    with open(path, encoding="utf-8", errors="replace") as log:
        for line in log:
            match = DURATION.search(line)
            if match:
                durations.append(float(match.group(1)) * UNITS_TO_MS[match.group(2)])
    return sorted(durations)


def percentile(sorted_values, p):
    if not sorted_values:
        return float("nan")
    index = round((len(sorted_values) - 1) * p / 100)
    return sorted_values[index]


def summarize(durations):
    summary = {"frames": len(durations)}
    for p in PERCENTILES:
        summary[f"p{p}"] = percentile(durations, p)
    summary["max"] = durations[-1] if durations else float("nan")
    for budget in BUDGETS_MS:
        summary[f"over {budget} ms"] = sum(1 for d in durations if d > budget)
    return summary


def main(paths):
    if not paths:
        print(__doc__)
        return 2
    summaries = [(path, summarize(read_durations_ms(path))) for path in paths]
    keys = list(summaries[0][1])
    name_width = max(len(path) for path in paths)
    print(f"{'':{name_width}}  " + "".join(f"{key:>14}" for key in keys))
    baseline = summaries[0][1]
    for index, (path, summary) in enumerate(summaries):
        cells = []
        for key in keys:
            value = summary[key]
            cells.append(f"{value:>14}" if isinstance(value, int) else f"{value:>11.2f} ms")
        print(f"{path:{name_width}}  " + "".join(cells))
        if index > 0:
            changes = []
            for key in keys:
                before, after = baseline[key], summary[key]
                if key == "frames" or before in (0, float("nan")):
                    changes.append(f"{'':>14}")
                else:
                    changes.append(f"{(after - before) / before * 100:>+13.1f}%")
            print(f"{'vs ' + paths[0]:{name_width}}  " + "".join(changes))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
