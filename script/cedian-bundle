#!/usr/bin/env bash
# Assemble `cedian.app` from the release build (U13, ADR-0058's packaging unit).
#
# The bundle is built unsigned: it is the owner's own build (ADR-0062), so
# signing and notarization are for redistributing it, not for running it. A
# set `CODESIGN_IDENTITY` signs it anyway. `script/cedian-build-omp` builds the
# pinned OMP sidecar from `vendor/omp-revision.json` (ADR-0003's recorded
# triple); set `CEDIAN_SKIP_OMP=1` to skip it, and the bundle then needs an
# `omp` on PATH (the app prefers the sidecar when it is there).
#
#   script/cedian-bundle
#   CODESIGN_IDENTITY="Developer ID Application: …" script/cedian-bundle
set -euo pipefail
cd "$(unset GIT_DIR GIT_WORK_TREE; git -C "$(dirname "$0")" rev-parse --show-toplevel)"

BIN=${CEDIAN_BIN:-target/release/cedian}
APP=${CEDIAN_APP:-cedian.app}
VERSION=${CEDIAN_VERSION:-$(sed -n 's/^pub const APP_VERSION: &str = "\(.*\)";$/\1/p' crates/paths/src/paths.rs)}
IDENTITY=${CODESIGN_IDENTITY:-}
BUNDLE_ID=${CEDIAN_BUNDLE_ID:-dev.cedian.Cedian}

# Two packages ship a binary named `cedian` (the app in `zed`, the headless CLI
# in `cedian_cli`), so they share one output path and the last build wins. The
# bundle builds the app itself unless `CEDIAN_NO_BUILD=1`.
if [ "${CEDIAN_NO_BUILD:-0}" != 1 ]; then
  cargo build -j4 --release -p zed --bin cedian --features gpui_platform/runtime_shaders
fi

[ -x "$BIN" ] || {
  echo "cedian-bundle: $BIN is not built; build it with:" >&2
  echo "  cargo build -j4 --release -p zed --bin cedian --features gpui_platform/runtime_shaders" >&2
  exit 2
}

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN" "$APP/Contents/MacOS/cedian"

cat >"$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>cedian</string>
  <key>CFBundleDisplayName</key><string>cedian</string>
  <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
  <key>CFBundleExecutable</key><string>cedian</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
</dict>
</plist>
PLIST

# The icon is U13's branding step: `script/cedian-icon` draws
# `cedian/assets/AppIcon.icns` (the chevron mark), and the bundle carries it.
ICON=cedian/assets/AppIcon.icns
if [ -f "$ICON" ]; then
  cp "$ICON" "$APP/Contents/Resources/AppIcon.icns"
else
  echo "cedian-bundle: no $ICON: run script/cedian-icon to draw it" >&2
fi

if [ "${CEDIAN_SKIP_OMP:-0}" = 1 ]; then
  echo "cedian-bundle: CEDIAN_SKIP_OMP=1: no Contents/Resources/omp; cedian then finds an omp on PATH or in ~/.local/bin (ADR-0057 decision 4)" >&2
else
  script/cedian-build-omp
fi

if [ -n "$IDENTITY" ]; then
  codesign --force --deep --options runtime --timestamp --sign "$IDENTITY" "$APP"
  echo "cedian-bundle: signed as $IDENTITY"
  echo "cedian-bundle: notarize with: xcrun notarytool submit <zip> --keychain-profile <profile> --wait && xcrun stapler staple $APP" >&2
else
  echo "cedian-bundle: built unsigned (ADR-0062: the owner's own build ships unsigned); CODESIGN_IDENTITY signs it, and redistribution needs signing and notarization" >&2
fi
echo "cedian-bundle: $APP"
