#!/usr/bin/env bash
# Format, lint and test the cedian crates only (ADR-0042), so a check never
# builds all of Zed. `script/cedian-check check` stops after `cargo check`.
set -euo pipefail
# Git sets GIT_DIR when it runs a hook, and with it `rev-parse --show-toplevel`
# answers the current directory, not the checkout a worktree is. Unset, so the
# discovery from this script's own directory is what answers.
cd "$(unset GIT_DIR GIT_WORK_TREE; git -C "$(dirname "$0")" rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$PATH"
export CARGO_PROFILE_DEV_DEBUG=${CARGO_PROFILE_DEV_DEBUG:-line-tables-only}
# A full disk mid-build fails with no useful message; free build output first.
# One check run needs about 9 GB, and linking the test binaries added on top of
# what was there when the run started, so keep 20 GB free (12 GB was not enough:
# the run of 2026-10-11 died in `ld` with 12 GB free and no `incremental` pruned).
script/cedian-prune 20

crates=(omp-rpc)
for dir in crates/cedian_*; do
  name=$(basename "$dir")
  crates+=("$name")
done
pkgs=()
for c in "${crates[@]}"; do pkgs+=(-p "$c"); done

files=()
while IFS= read -r f; do files+=("$f"); done < <(find crates/cedian_* -name '*.rs' -not -path '*/target/*')
rustfmt --edition 2024 --check "${files[@]}"
script/check-licenses
# The benchmark harness: turn cap, OMP wrapper, model check (fake OMP only).
python3 script/cedian-bench/test_bench.py
if [ "${1:-}" = check ]; then
  cargo check -j4 --all-targets "${pkgs[@]}"
  exit 0
fi
# Vendored upstream code is built and tested, not linted.
lint=("${pkgs[@]:2}")
cargo clippy -j4 --all-targets --no-deps "${lint[@]}" -- -D warnings
# Tests run with an empty HOME so one that reads the owner's real ~/.omp fails
# here the way it fails on CI. Cargo and rustup keep their real homes.
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
test_home=$(mktemp -d)
trap 'rm -rf "$test_home"' EXIT
HOME="$test_home" cargo test -j4 "${pkgs[@]}"
