<body>
<div class="shell">
  <header class="topbar">
    <div class="topline">
      <h1>Zed documentation link review</h1>
      <span class="counter" id="counter"></span>
      <div class="progress"><div id="progress"></div></div>
      <span class="progress-label" id="progressLabel"></span>
      <span class="spacer"></span>
      <span class="save-state" id="saveState"></span>
      <button class="utility" id="exportButton">Export labels</button>
    </div>
    <div class="filters">
      <label>Queue
        <select id="queueFilter">
          <option value="all">All actionable items</option>
          <option value="automatic">Automatic candidates</option>
