          <option value="defer">Defer</option>
        </select>
      </label>
      <input type="search" id="search" placeholder="Jump to path or ID">
      <span class="spacer"></span>
      <span class="shortcut">←/→ navigate · 1 pass · 2 fail · D defer · U undo</span>
      <div class="navigation">
        <button class="nav-button" id="previous">Previous</button>
        <button class="nav-button" id="next">Next</button>
      </div>
    </div>
  </header>
  <main class="main" id="main"><div class="empty">Loading review queue…</div></main>
</div>
<script>window.__REVIEW_STATE__ = null;</script>
<script>
const state = {
  items: [],
  itemDetails: {},
  labels: {},
  filtered: [],
  index: 0,
  current: null,
  history: [],
};

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function renderInline(value) {
  let text = escapeHtml(value);
  text = text.replace(/`([^`]+)`/g, "<code>$1</code>");
  text = text.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  return text;
}

function renderMarkdown(value) {
  const lines = String(value ?? "").split("\n");
  const output = [];
  let inCode = false;
  let code = [];
  let listOpen = false;
  for (const raw of lines) {
    if (raw.trim().startsWith("```")) {
      if (inCode) {
        output.push(`<pre><code>${escapeHtml(code.join("\n"))}</code></pre>`);
        code = [];
      }
      inCode = !inCode;
      continue;
    }
    if (inCode) { code.push(raw); continue; }
    const heading = raw.match(/^(#{1,4})\s+(.+)$/);
    const list = raw.match(/^\s*-\s+(.+)$/);
    if (!list && listOpen) { output.push("</ul>"); listOpen = false; }
    if (heading) {
      const level = Math.min(heading[1].length + 1, 5);
      output.push(`<h${level}>${renderInline(heading[2])}</h${level}>`);
    } else if (list) {
      if (!listOpen) { output.push("<ul>"); listOpen = true; }
      output.push(`<li>${renderInline(list[1])}</li>`);
    } else if (raw.startsWith(">")) {
      output.push(`<blockquote>${renderInline(raw.replace(/^>\s?/, ""))}</blockquote>`);
    } else if (raw.trim().startsWith("|")) {
      output.push(`<pre>${escapeHtml(raw)}</pre>`);
    } else if (raw.trim()) {
      output.push(`<p>${renderInline(raw)}</p>`);
    }
  }
  if (listOpen) output.push("</ul>");
  if (inCode) output.push(`<pre><code>${escapeHtml(code.join("\n"))}</code></pre>`);
  return output.join("");
}

function highlightedContext(item) {
  const context = item.context || item.source_excerpt || "";
  const anchor = item.selected_anchor?.text;
  if (!anchor || !context.includes(anchor)) return renderMarkdown(context);
  const token = "__ANCHOR_MARK__";
  const marked = context.replace(anchor, token);
  return renderMarkdown(marked).replace(token, `<mark>${escapeHtml(anchor)}</mark>`);
}

function itemLabel(id) {
  return state.labels[id] || {label: null, notes: ""};
}

function applyFilters(preserveId = null) {
  const queue = document.getElementById("queueFilter").value;
  const label = document.getElementById("labelFilter").value;
  const query = document.getElementById("search").value.toLowerCase().trim();
  state.filtered = state.items.filter(item => {
    if (queue !== "all" && item.queue !== queue) return false;
    const currentLabel = itemLabel(item.id).label;
    if (label === "unlabeled" && currentLabel) return false;
    if (label !== "all" && label !== "unlabeled" && currentLabel !== label) return false;
    if (query && !`${item.id} ${item.source_path} ${item.target_path}`.toLowerCase().includes(query)) return false;
    return true;
  });
  if (preserveId) {
    const found = state.filtered.findIndex(item => item.id === preserveId);
    state.index = found >= 0 ? found : Math.min(state.index, Math.max(0, state.filtered.length - 1));
  } else {
    state.index = Math.min(state.index, Math.max(0, state.filtered.length - 1));
  }
  loadCurrent();
}

async function loadCurrent() {
  const main = document.getElementById("main");
  if (!state.filtered.length) {
    state.current = null;
    main.innerHTML = '<div class="card empty">No items match these filters.</div>';
    updateChrome();
    return;
  }
  const summary = state.filtered[state.index];
  if (state.itemDetails[summary.id]) {
    state.current = state.itemDetails[summary.id];
  } else {
    const response = await fetch(`/api/item?id=${encodeURIComponent(summary.id)}`);
    state.current = await response.json();
  }
  renderCurrent();
}

function renderCurrent() {
  const item = state.current;
  const label = itemLabel(item.id);
  const proposal = item.rewrite
    ? `<div class="markdown">${renderMarkdown(item.rewrite)}</div>`
    : item.selected_anchor
      ? `<code>[${escapeHtml(item.selected_anchor.text)}](${escapeHtml(item.relative_target)})</code>`
      : `<strong>${escapeHtml(item.anchor_choice)}</strong>`;
  const candidates = (item.anchor_candidates || [])
    .slice(0, 8)
    .map(candidate => `<div class="candidate"><span class="prob">${candidate.probability.toFixed(2)}</span><code>${escapeHtml(candidate.text)}</code></div>`)
    .join("");
  document.getElementById("main").innerHTML = `
    <article class="card">
      <div class="header">
        <div class="route">
          <div><div class="path">Source</div><h2>${escapeHtml(item.source_path)}</h2></div>
          <div class="arrow">→</div>
          <div><div class="path">Destination</div><h2>${escapeHtml(item.target_path)}</h2></div>
        </div>
        <div class="badges">
          <span class="badge">Queue: <strong>${escapeHtml(item.queue_label)}</strong></span>
          <span class="badge">Reason: <strong>${item.reason_probability.toFixed(2)}</strong></span>
          <span class="badge">Anchor exists: <strong>${item.anchor_probability.toFixed(2)}</strong></span>
          <span class="badge">Exact phrase: <strong>${item.anchor_choice_probability.toFixed(2)}</strong></span>
          <span class="badge">Jev: <strong>${escapeHtml(item.anchor_choice)}</strong></span>
        </div>
      </div>
      <div class="content">
        <section class="primary">
          <h3>Source context</h3>
          <div class="context markdown">${highlightedContext(item)}</div>
          <h3>Proposed change</h3>
          <div class="proposal">${proposal}</div>
          ${candidates ? `<h3>Other anchor candidates</h3><div>${candidates}</div>` : ""}
        </section>
        <aside class="sidebar">
          <h3>Review decision</h3>
          <div class="actions">
            <button class="action pass ${label.label === "pass" ? "active" : ""}" data-label="pass">1 · Pass</button>
            <button class="action fail ${label.label === "fail" ? "active" : ""}" data-label="fail">2 · Fail</button>
            <button class="action defer ${label.label === "defer" ? "active" : ""}" data-label="defer">D · Defer</button>
          </div>
          <textarea id="notes" placeholder="Why should this pass, fail, or wait?">${escapeHtml(label.notes || "")}</textarea>
          <div class="path">ID: ${escapeHtml(item.id)}</div>
        </aside>
      </div>
      <details>
        <summary>Full source page</summary>
        <div class="document markdown">${renderMarkdown(item.source_markdown)}</div>
      </details>
      <details>
        <summary>Full destination page</summary>
        <div class="document markdown">${renderMarkdown(item.target_markdown)}</div>
      </details>
    </article>`;
  document.querySelectorAll("[data-label]").forEach(button => {
    button.addEventListener("click", () => setLabel(button.dataset.label));
  });
  document.getElementById("notes").addEventListener("input", debounce(saveNotes, 350));
  updateChrome();
}

function updateChrome() {
  const total = state.filtered.length;
  const position = total ? state.index + 1 : 0;
  const labeled = state.items.filter(item => itemLabel(item.id).label).length;
  document.getElementById("counter").textContent = `${position} of ${total}`;
  document.getElementById("progress").style.width = `${state.items.length ? labeled / state.items.length * 100 : 0}%`;
  document.getElementById("progressLabel").textContent = `${labeled} of ${state.items.length} labeled`;
  document.getElementById("previous").disabled = state.index <= 0;
  document.getElementById("next").disabled = state.index >= total - 1;
}

async function persist(id, label, notes) {
  document.getElementById("saveState").textContent = "Saving…";
  if (window.__REVIEW_STATE__) {
    localStorage.setItem("zed-doc-link-review-labels", JSON.stringify(state.labels));
  } else {
    const response = await fetch("/api/label", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({id, label, notes}),
    });
    if (!response.ok) throw new Error(await response.text());
  }
  document.getElementById("saveState").textContent = "Saved";
  setTimeout(() => {
    if (document.getElementById("saveState").textContent === "Saved") {
      document.getElementById("saveState").textContent = "";
    }
  }, 900);
}

async function setLabel(label) {
  if (!state.current) return;
  const id = state.current.id;
  const previous = {...itemLabel(id)};
  const notes = document.getElementById("notes").value;
  state.history.push({id, previous});
  state.labels[id] = {label, notes};
  await persist(id, label, notes);
  const nextId = state.filtered[state.index + 1]?.id;
  applyFilters(nextId);
}

async function saveNotes() {
  if (!state.current) return;
  const id = state.current.id;
  const current = itemLabel(id);
  const notes = document.getElementById("notes").value;
  state.labels[id] = {...current, notes};
  await persist(id, current.label, notes);
}

async function undo() {
  const action = state.history.pop();
  if (!action) return;
  state.labels[action.id] = action.previous;
  await persist(action.id, action.previous.label, action.previous.notes);
  applyFilters(action.id);
}

function navigate(delta) {
  if (!state.filtered.length) return;
  state.index = Math.max(0, Math.min(state.filtered.length - 1, state.index + delta));
  loadCurrent();
}

function debounce(fn, wait) {
  let timer;
  return (...args) => {
    clearTimeout(timer);
    timer = setTimeout(() => fn(...args), wait);
  };
}

async function initialize() {
  let initial;
  if (window.__REVIEW_STATE__) {
    initial = window.__REVIEW_STATE__;
    state.itemDetails = Object.fromEntries(
      initial.items.map(item => [item.id, item])
    );
    state.items = initial.items.map(item => ({
      id: item.id,
      queue: item.queue,
      source_path: item.source_path,
      target_path: item.target_path,
    }));
    const saved = localStorage.getItem("zed-doc-link-review-labels");
    state.labels = saved ? JSON.parse(saved) : initial.labels;
  } else {
    const response = await fetch("/api/state");
    initial = await response.json();
    state.items = initial.items;
    state.labels = initial.labels;
  }
  applyFilters();
}

function exportLabels() {
  if (!window.__REVIEW_STATE__) {
    window.location.href = "/api/export";
    return;
  }
  const approved = Object.entries(state.labels)
    .filter(([, review]) => review.label === "pass")
    .map(([identifier, review]) => ({
      item: state.itemDetails[identifier],
      review,
    }));
  const body = JSON.stringify({labels: state.labels, approved}, null, 2);
  const link = document.createElement("a");
  link.href = URL.createObjectURL(
    new Blob([body], {type: "application/json"})
  );
  link.download = "doc-link-review.json";
  link.click();
  URL.revokeObjectURL(link.href);
}

document.getElementById("queueFilter").addEventListener("change", () => applyFilters());
document.getElementById("labelFilter").addEventListener("change", () => applyFilters());
document.getElementById("search").addEventListener("input", debounce(() => {
  state.index = 0;
  applyFilters();
}, 150));
document.getElementById("previous").addEventListener("click", () => navigate(-1));
document.getElementById("next").addEventListener("click", () => navigate(1));
document.getElementById("exportButton").addEventListener("click", exportLabels);
document.addEventListener("keydown", event => {
  if (event.target.matches("textarea, input, select")) return;
  if (event.key === "ArrowLeft") navigate(-1);
  if (event.key === "ArrowRight") navigate(1);
  if (event.key === "1") setLabel("pass");
  if (event.key === "2") setLabel("fail");
  if (event.key.toLowerCase() === "d") setLabel("defer");
  if (event.key.toLowerCase() === "u") undo();
  if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
    setLabel(itemLabel(state.current?.id).label || "defer");
  }
});
initialize();
</script>
</body>
</html>
"""


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Review Zed documentation link audit results in a browser."
    )
    parser.add_argument(
        "--report",
        type=Path,
        default=Path("target/doc-link-audit/audit.json"),
    )
    parser.add_argument(
        "--rewrites",
        type=Path,
        default=Path("target/doc-link-audit/rewrite-selection.json"),
    )
    parser.add_argument(
        "--labels",
        type=Path,
        default=Path("target/doc-link-audit/review-labels.json"),
    )
    parser.add_argument("--docs-dir", type=Path, default=Path("docs/src"))
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--no-open", action="store_true")
    parser.add_argument(
        "--static-output",
        type=Path,
        help="Write a self-contained HTML review file instead of starting a server.",
    )
    parser.add_argument(
        "--apply-export",
        type=Path,
        help="Validate and apply passed exact-anchor items from an exported review.",
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="Write approved exact-anchor changes. Without this, only validate.",
    )
    parser.add_argument(
        "--allow-updated-sources",
        action="store_true",
        help="Apply reviewed anchors when source files changed after the audit.",
    )
    return parser.parse_args()


def stable_id(source: str, target: str, queue: str, revision: str) -> str:
    digest = hashlib.sha256(
        f"{queue}:{source}:{target}:{revision}".encode()
    ).hexdigest()[:10]
    return f"{queue}:{digest}"


def read_markdown(docs_dir: Path, relative_path: str) -> str:
    path = docs_dir / relative_path.split("#", 1)[0]
    if not path.is_file():
        return ""
    return path.read_text(encoding="utf-8")


def anchor_options(decision: dict) -> list[dict]:
    probabilities = decision.get("anchor_probabilities", {})
    anchors = {
        candidate["id"]: candidate for candidate in decision.get("anchor_candidates", [])
    }
    options = []
    for identifier, probability in probabilities.items():
        candidate = anchors.get(identifier)
        if not candidate:
            continue
        options.append(
            {
                "id": identifier,
                "text": candidate["text"],
                "probability": float(probability),
            }
        )
    return sorted(options, key=lambda option: -option["probability"])


def build_item(
    decision: dict,
    queue: str,
    queue_label: str,
    docs_dir: Path,
    rewrite: dict | None = None,
) -> dict:
    selected_anchor = decision.get("selected_anchor")
    source_markdown = read_markdown(docs_dir, decision["source_path"])
    rewrite_text = rewrite.get("selected_rewrite") if rewrite else None
    revision = hashlib.sha256(
        json.dumps(
            {
                "source_markdown": source_markdown,
                "selected_anchor": selected_anchor,
                "rewrite": rewrite_text,
            },
            sort_keys=True,
        ).encode()
    ).hexdigest()
    context = (
        selected_anchor.get("context")
        if selected_anchor
        else decision.get("candidate_passages", [{}])[0].get("text", "")
    )
    return {
        "id": stable_id(
            decision["source_path"],
            decision["target_path"],
            queue,
            revision,
        ),
        "queue": queue,
        "queue_label": queue_label,
        "source_path": decision["source_path"],
        "target_path": decision["target_path"],
        "relative_target": decision.get("relative_target", ""),
        "reason_probability": float(decision["reason_probability"]),
        "anchor_probability": float(decision["anchor_probability"]),
        "anchor_choice_probability": float(
            decision.get("anchor_choice_probability", 0)
        ),
        "anchor_choice": decision.get("anchor_choice", ""),
        "selected_anchor": selected_anchor,
        "anchor_candidates": anchor_options(decision),
        "context": context,
        "rewrite": rewrite_text,
        "rewrite_choice": rewrite.get("choice") if rewrite else None,
        "rewrite_confidence": rewrite.get("confidence") if rewrite else None,
        "source_markdown": source_markdown,
        "target_markdown": read_markdown(docs_dir, decision["target_path"]),
    }


def load_items(report_path: Path, rewrites_path: Path, docs_dir: Path) -> list[dict]:
    report = json.loads(report_path.read_text(encoding="utf-8"))
    rewrite_results = {}
    if rewrites_path.is_file():
        rewrite_data = json.loads(rewrites_path.read_text(encoding="utf-8"))
        rewrite_results = {
            (
                value["source_path"],
                value["target_path"].split("#", 1)[0],
            ): value
            for value in rewrite_data.get("selections", {}).values()
        }

    items = []
    for decision in report["decisions"]:
        status = decision["status"]
        if status == "suggested":
            items.append(
                build_item(
                    decision,
                    "automatic",
                    "Automatic candidate",
                    docs_dir,
                )
            )
        elif status == "rewrite_candidate":
            rewrite = rewrite_results.get(
                (decision["source_path"], decision["target_path"])
            )
            items.append(
                build_item(
                    decision,
                    "rewrite",
                    "Generated rewrite",
                    docs_dir,
                    rewrite,
                )
            )
        elif status == "review" and decision["reason_probability"] >= 0.80:
            items.append(
                build_item(
                    decision,
                    "strong_review",
                    "Strong reason, uncertain anchor",
                    docs_dir,
                )
            )
        elif (
            status == "review"
            and 0.75 <= decision["reason_probability"] < 0.80
            and decision["anchor_probability"] >= 0.80
            and decision.get("selected_anchor")
            and decision["anchor_choice_probability"] >= 0.60
        ):
            items.append(
                build_item(
                    decision,
                    "near_review",
                    "Near-threshold reason",
                    docs_dir,
                )
            )

    queue_order = {
        "automatic": 0,
        "rewrite": 1,
        "strong_review": 2,
        "near_review": 3,
    }
    return sorted(
        items,
        key=lambda item: (
            queue_order[item["queue"]],
            -item["reason_probability"],
            -item["anchor_probability"],
            item["source_path"],
            item["target_path"],
        ),
    )


def load_labels(path: Path) -> dict:
    if not path.is_file():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))


def save_labels(path: Path, labels: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(labels, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    temporary.replace(path)


def apply_export(
    path: Path,
    docs_dir: Path,
    write: bool,
    allow_updated_sources: bool,
) -> int:
    exported = json.loads(path.read_text(encoding="utf-8"))
    approved = [
        entry["item"]
        for entry in exported.get("approved", [])
        if entry["item"]["queue"] != "rewrite"
    ]
    by_source = {}
    for item in approved:
        by_source.setdefault(item["source_path"], []).append(item)

    modified = {}
    skipped = []
    already_applied = []
    for source_path, items in by_source.items():
        path = docs_dir / source_path
        current = path.read_text(encoding="utf-8")
        expected_versions = {item["source_markdown"] for item in items}
        if len(expected_versions) != 1:
            raise RuntimeError(
                f"{source_path} has inconsistent reviewed source versions."
            )
        if current not in expected_versions and not allow_updated_sources:
            raise RuntimeError(
                f"{source_path} changed after review; regenerate the audit."
            )
        text = current
        for item in items:
            selected_anchor = item.get("selected_anchor")
            if not selected_anchor:
                raise RuntimeError(
                    f"{item['id']} was approved without an exact anchor."
                )
            anchor = selected_anchor["text"]
            context = " ".join(item.get("context", "").split())
            replacement = f"[{anchor}]({item['relative_target']})"
            if replacement in text:
                already_applied.append(
                    f"{source_path}: {anchor!r} → "
                    f"{item['relative_target']}"
                )
                continue
            linked_ranges = [
                match.span()
                for match in re.finditer(
                    r"!?\[[^\]]*\]\([^)]+\)",
                    text,
                )
            ]
            occurrences = []
            for match in re.finditer(re.escape(anchor), text):
                if any(
                    start <= match.start() < end
                    for start, end in linked_ranges
                ):
                    continue
                line_start = text.rfind("\n", 0, match.start()) + 1
                line_end = text.find("\n", match.end())
                if line_end < 0:
                    line_end = len(text)
                line = " ".join(text[line_start:line_end].split())
                occurrences.append(
                    (
                        SequenceMatcher(None, line, context).ratio(),
                        match.start(),
                        match.end(),
                    )
                )
            if not occurrences:
                if allow_updated_sources:
                    skipped.append(
                        f"{source_path}: {anchor!r} → "
                        f"{item['relative_target']}"
                    )
                    continue
                raise RuntimeError(
                    f"No unlinked occurrence of {anchor!r} in {source_path}."
                )
            _, start, end = max(occurrences)
            text = text[:start] + replacement + text[end:]
        modified[path] = text

    applicable_count = len(approved) - len(skipped) - len(already_applied)
    print(
        f"Validated {applicable_count} approved exact anchors "
        f"across {len(modified)} files."
    )
    if already_applied:
        print(f"{len(already_applied)} approved anchors were already present.")
    if skipped:
        print("Skipped approved anchors missing from updated source files:")
        for description in skipped:
            print(f"- {description}")
    if not write:
        print("No files changed. Pass --write to apply them.")
        return 0
    for path, text in modified.items():
        path.write_text(text, encoding="utf-8")
    print(f"Applied {applicable_count} exact anchors.")
    return 0


class ReviewServer(ThreadingHTTPServer):
    def __init__(self, address, handler, items, labels_path):
        super().__init__(address, handler)
        self.items = {item["id"]: item for item in items}
        self.item_summaries = [
            {
                "id": item["id"],
                "queue": item["queue"],
                "source_path": item["source_path"],
                "target_path": item["target_path"],
            }
            for item in items
        ]
        self.labels_path = labels_path
        self.labels = load_labels(labels_path)
        self.labels_lock = threading.Lock()


class Handler(BaseHTTPRequestHandler):
    server: ReviewServer

    def log_message(self, format_string, *args):
        return

    def send_json(self, value, status=HTTPStatus.OK, download_name=None):
        body = json.dumps(value, indent=2, sort_keys=True).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        if download_name:
            self.send_header(
                "Content-Disposition",
                f'attachment; filename="{download_name}"',
            )
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/":
            body = HTML.encode()
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/state":
            self.send_json(
                {
                    "items": self.server.item_summaries,
                    "labels": self.server.labels,
                }
            )
            return
        if parsed.path == "/api/item":
            identifier = parse_qs(parsed.query).get("id", [None])[0]
            item = self.server.items.get(identifier)
            if item is None:
                self.send_json({"error": "unknown item"}, HTTPStatus.NOT_FOUND)
            else:
                self.send_json(item)
            return
        if parsed.path == "/api/export":
            approved = [
                {
                    "item": self.server.items[identifier],
                    "review": label,
                }
                for identifier, label in self.server.labels.items()
                if label.get("label") == "pass"
                and identifier in self.server.items
            ]
            self.send_json(
                {
                    "labels": self.server.labels,
                    "approved": approved,
                },
                download_name="doc-link-review.json",
            )
            return
        self.send_json({"error": "not found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self):
        if urlparse(self.path).path != "/api/label":
            self.send_json({"error": "not found"}, HTTPStatus.NOT_FOUND)
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length))
            identifier = payload["id"]
            label = payload.get("label")
            notes = str(payload.get("notes", ""))
        except (KeyError, TypeError, ValueError, json.JSONDecodeError):
            self.send_json({"error": "invalid payload"}, HTTPStatus.BAD_REQUEST)
            return
        if identifier not in self.server.items:
            self.send_json({"error": "unknown item"}, HTTPStatus.NOT_FOUND)
            return
        if label not in (None, "pass", "fail", "defer"):
            self.send_json({"error": "invalid label"}, HTTPStatus.BAD_REQUEST)
            return
        with self.server.labels_lock:
            self.server.labels[identifier] = {
                "label": label,
                "notes": notes,
            }
            save_labels(self.server.labels_path, self.server.labels)
        self.send_json({"ok": True})


def main() -> int:
    arguments = parse_arguments()
    if arguments.apply_export:
        return apply_export(
            arguments.apply_export,
            arguments.docs_dir,
            arguments.write,
            arguments.allow_updated_sources,
        )
    items = load_items(arguments.report, arguments.rewrites, arguments.docs_dir)
    if not items:
        raise SystemExit("No actionable audit items found.")
    if arguments.static_output:
        initial = {
            "items": items,
            "labels": load_labels(arguments.labels),
        }
        embedded = json.dumps(initial, separators=(",", ":")).replace(
            "<", "\\u003c"
        )
        html = HTML.replace(
            "window.__REVIEW_STATE__ = null;",
            f"window.__REVIEW_STATE__ = {embedded};",
            1,
        )
        arguments.static_output.parent.mkdir(parents=True, exist_ok=True)
        arguments.static_output.write_text(html, encoding="utf-8")
        url = arguments.static_output.resolve().as_uri()
        print(f"Wrote {arguments.static_output}")
        print(f"Reviewing {len(items)} items at {url}")
        if not arguments.no_open:
            webbrowser.open(url)
        return 0
    server = ReviewServer(
        (arguments.host, arguments.port),
        Handler,
        items,
        arguments.labels,
    )
    url = f"http://{arguments.host}:{arguments.port}"
    queue_counts = {}
    for item in items:
        queue_counts[item["queue"]] = queue_counts.get(item["queue"], 0) + 1
    print(f"Reviewing {len(items)} items at {url}")
    print(
        ", ".join(
            f"{queue}: {count}" for queue, count in queue_counts.items()
        )
    )
    print(f"Labels save to {arguments.labels}")
    if not arguments.no_open:
        threading.Timer(0.25, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
