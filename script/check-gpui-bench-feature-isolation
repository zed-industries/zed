#!/usr/bin/env bash

set -euo pipefail

# GPUI's canonical benchmark support and its compatibility alias must stay
# usable without pulling in `test-support`, so `#[gpui::bench]` consumers
# compile only production-capable code.
cd "$(dirname "$0")/.."

for feature in bench-support bench; do
  output=$(cargo tree \
    --offline \
    --package gpui \
    --no-default-features \
    --features "${feature}" \
    --edges features \
    --invert gpui)

  if grep --quiet 'gpui feature "test-support"' <<< "${output}"; then
    echo "gpui's \"${feature}\" feature pulls in \"test-support\":"
    echo "${output}"
    exit 1
  fi
done
