name: zed
title: Zed
base: core26
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Zed is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
website: https://zed.dev/
source-code: https://github.com/zed-industries/zed
issues: https://github.com/zed-industries/zed/issues
contact: https://zed.dev/community-links#support-and-feedback

parts:
  zed:
    plugin: dump
    source: "https://github.com/zed-industries/zed/releases/download/v$RELEASE_VERSION/zed-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec
      # snapcraft's desktop-file lint resolves a bare Icon=zed against the
      # hicolor theme only under usr/share/icons, so move the tarball's
      # icons there.
      share/icons: usr/share/icons

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      # Zed fails to start with "error while loading shared libraries:
      # libX11-xcb.so.1" without this.
      - libx11-xcb1
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0
      # Mesa's Vulkan drivers (RADV, lavapipe, ...) so real AMD GPUs work
      # even when the host drivers were built against a glibc newer than
      # the base, and containers get a software fallback without relying
      # on the host's Mesa.
      - mesa-vulkan-drivers

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball. The tarball's share/ stays: it
      # holds the desktop entry and hicolor icons used for menu integration
      # (see the app's desktop key below).
      - -lib
      - -licenses.md

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zed:
    command: usr/bin/zed
    common-id: dev.zed.Zed
    # Menu integration: snapcraft copies this into meta/gui, rewrites Exec to
    # the snap command and resolves the bare Icon=zed against the primed
    # hicolor icons; snapd then exports it to /var/lib/snapd/desktop/
    # applications on install. The desktop entry in the tarball is generated
    # for the stable channel, so the id always matches dev.zed.Zed.
    desktop: share/applications/dev.zed.Zed.desktop
    environment:
      ZED_BUNDLE_TYPE: snap
      # snapcraft sets DF_1_NODEFLIB on all ELFs of the snap, which makes the
      # dynamic linker ignore /etc/ld.so.cache for them, and the Vulkan loader
      # dlopens ICD libraries by bare soname. Bundled sonames still resolve
      # through the RPATH snapcraft injects ($ORIGIN), but host ICD libraries
      # not shipped in the snap (e.g. NVIDIA's) need these host directories.
      LD_LIBRARY_PATH: $SNAP/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu
      # The Vulkan loader only discovers ICD manifests under the host's XDG
      # paths, never $SNAP/usr/share/vulkan/icd.d, so without this the bundled
      # Mesa ICDs would be invisible on hosts without Vulkan drivers (e.g.
      # containers) and the software fallback would be lost. Listing the
      # bundled manifests also keeps every Vulkan library resolving to the
      # snap's own coherent Mesa build instead of the host's, which may not
      # match the base runtime. Host Mesa manifests are omitted on purpose;
      # they would only shadow the bundled ones. Missing files in the list
      # are ignored, and both NVIDIA manifest locations are listed because
      # the driver package may install either.
      VK_DRIVER_FILES: $SNAP/usr/share/vulkan/icd.d/radeon_icd.json:$SNAP/usr/share/vulkan/icd.d/intel_icd.json:$SNAP/usr/share/vulkan/icd.d/intel_hasvk_icd.json:$SNAP/usr/share/vulkan/icd.d/nouveau_icd.json:$SNAP/usr/share/vulkan/icd.d/lvp_icd.json:/usr/share/vulkan/icd.d/nvidia_icd.json:/etc/vulkan/icd.d/nvidia_icd.json
