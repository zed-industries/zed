name: zed
title: Zed
base: core26
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Zed is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
website: https://zed.dev/
source-code: https://github.com/zed-industries/zed
issues: https://github.com/zed-industries/zed/issues
contact: https://zed.dev/community-links#support-and-feedback

parts:
  zed:
    plugin: dump
    source: "https://github.com/zed-industries/zed/releases/download/v$RELEASE_VERSION/zed-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      # Zed fails to start with "error while loading shared libraries:
      # libX11-xcb.so.1" without this.
      - libx11-xcb1
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0
      # Mesa's Vulkan drivers (RADV, lavapipe, ...) so real AMD GPUs work
      # even when the host drivers were built against a glibc newer than
      # the base, and containers get a software fallback without relying
      # on the host's Mesa.
      - mesa-vulkan-drivers

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zed:
    command: usr/bin/zed
    common-id: dev.zed.Zed
    environment:
      ZED_BUNDLE_TYPE: snap
      # snapcraft sets DF_1_NODEFLIB on all ELFs of classic snaps, which makes
      # the dynamic linker refuse to resolve bare sonames via /etc/ld.so.cache.
      # The Vulkan loader dlopens ICDs by bare soname, so the bundled Mesa
      # drivers must come first here; the host directories afterwards provide
      # anything not bundled (e.g. the NVIDIA ICD library).
      LD_LIBRARY_PATH: $SNAP/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu
      # Enumerate only our bundled Mesa ICDs plus the host's NVIDIA one. The
      # host's Mesa ICD manifests must not be discovered: their libraries were
      # built for the host's glibc (which may be newer than the base's) and,
      # for lavapipe, they pull in the host's libgallium, which mismatches the
      # bundled lavapipe and segfaults during device enumeration. Missing
      # files in the list are ignored, and both NVIDIA manifest locations are
      # listed because the driver package may install either.
      VK_DRIVER_FILES: $SNAP/usr/share/vulkan/icd.d/radeon_icd.json:$SNAP/usr/share/vulkan/icd.d/intel_icd.json:$SNAP/usr/share/vulkan/icd.d/intel_hasvk_icd.json:$SNAP/usr/share/vulkan/icd.d/nouveau_icd.json:$SNAP/usr/share/vulkan/icd.d/lvp_icd.json:/usr/share/vulkan/icd.d/nvidia_icd.json:/etc/vulkan/icd.d/nvidia_icd.json
      # wgpu also enumerates a GL backend via EGL. That would pull in the
      # host's GL stack (libEGL -> libEGL_mesa -> libgallium), which may be
      # built against a newer glibc than the base's and segfaults during
      # initialization. Pointing glvnd at a nonexistent vendor file makes
      # eglInitialize fail cleanly, so wgpu skips the GL adapter and renders
      # through Vulkan only, which the bundled drivers above cover.
      __EGL_VENDOR_LIBRARY_FILENAMES: /nonexistent-egl-vendor.json
