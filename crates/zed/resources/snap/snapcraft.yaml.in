name: zed
title: Zed
base: core26
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Zed is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
website: https://zed.dev/
source-code: https://github.com/zed-industries/zed
issues: https://github.com/zed-industries/zed/issues
contact: https://zed.dev/community-links#support-and-feedback

parts:
  zed:
    plugin: dump
    source: "https://github.com/zed-industries/zed/releases/download/v$RELEASE_VERSION/zed-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      # Zed fails to start with "error while loading shared libraries:
      # libX11-xcb.so.1" without this.
      - libx11-xcb1
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0
      # Mesa's RADV so real AMD GPUs work even when the host drivers were
      # built against a glibc newer than the base. Lavapipe is excluded from
      # this package (see the lavapipe-noble part below).
      - mesa-vulkan-drivers

    # Exclude core26's lavapipe: it segfaults during vkCreateDevice in the
    # classic snap environment (dl_iterate_phdr callback crash), while the
    # noble build works. libLLVM-21 stays: Ubuntu's RADV links against it.
    stage:
      - -usr/lib/x86_64-linux-gnu/libvulkan_lvp.so*
      - -usr/share/vulkan/icd.d/lvp_icd.json

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

  # Lavapipe from noble as the software rasterizer fallback (containers,
  # machines without a supported GPU). Noble's build links against older
  # glibc, so it loads in the core26 runtime and on any newer host. Only
  # the driver itself, its LLVM and its ICD manifest are primed; the rest
  # of the package would clash with the core26 Mesa files.
  lavapipe-noble:
    plugin: nil
    override-pull: |
      arch="$(dpkg --print-architecture)"
      curl -fsSL -o lvp.deb "https://archive.ubuntu.com/ubuntu/pool/main/m/mesa/mesa-vulkan-drivers_25.2.8-0ubuntu0.24.04.4_${arch}.deb"
      curl -fsSL -o llvm20.deb "https://archive.ubuntu.com/ubuntu/pool/main/l/llvm-toolchain-20/libllvm20_20.1.2-0ubuntu1~24.04.3_${arch}.deb"
    override-build: |
      dpkg -x lvp.deb "$SNAPCRAFT_PART_INSTALL"
      dpkg -x llvm20.deb "$SNAPCRAFT_PART_INSTALL"

    # Only the software rasterizer, its LLVM and its ICD manifest; the rest
    # of the package would clash with the core26 Mesa files.
    stage:
      - usr/lib/x86_64-linux-gnu/libvulkan_lvp.so
      - usr/lib/x86_64-linux-gnu/libLLVM.so.20.1
      - usr/share/vulkan/icd.d/lvp_icd.json
    prime:
      - usr/lib/x86_64-linux-gnu/libvulkan_lvp.so
      - usr/lib/x86_64-linux-gnu/libLLVM.so.20.1
      - usr/share/vulkan/icd.d/lvp_icd.json

apps:
  zed:
    command: usr/bin/zed
    common-id: dev.zed.Zed
    environment:
      ZED_BUNDLE_TYPE: snap
      # snapcraft sets DF_1_NODEFLIB on all ELFs of classic snaps, which makes
      # the dynamic linker refuse to resolve bare sonames via /etc/ld.so.cache.
      # The Vulkan loader dlopens ICDs by bare soname, so the bundled Mesa
      # drivers must come first here; the host directories afterwards provide
      # anything not bundled (e.g. the NVIDIA ICD).
      LD_LIBRARY_PATH: $SNAP/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu
