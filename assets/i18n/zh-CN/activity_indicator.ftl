# Simplified Chinese (zh-CN) catalog for the status bar activity indicator.
#
# Language server names, extension ids and debug adapter names come from the
# project and are not localized. The server's own message is a placeable in a
# whole sentence, one per severity, so a translation controls both the word order
# and the punctuation that separates them.

downloading-names = 正在下载 { $names }…
checking-for-updates-to-names = 正在检查 { $names } 的更新…
failed-to-run-names-click-to-show-error = 无法运行 { $names }。点击查看错误。
formatting-failed-failure-click-to-see-logs = 格式化失败：{ $failure }。点击查看日志。
language-server-name = 语言服务器 { $name }：
server-message = （{ $server }）{ $message }
server-warning-message = （{ $server }）警告：{ $message }
server-error-message = （{ $server }）错误：{ $message }
debug-adapter = 调试：{ $adapter }
installing-extension-extension = 正在安装 { $extension } 扩展…
updating-extension-extension = 正在更新 { $extension } 扩展…
removing-extension-extension = 正在移除 { $extension } 扩展…
cancel-title = 取消{ $title }
