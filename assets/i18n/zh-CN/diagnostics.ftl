# Simplified Chinese (zh-CN) catalog for the diagnostics views, their toolbar
# and the status bar indicator.
#
# The status bar label enumerates every singular/plural combination as a whole
# sentence, because the English forms have to stay exact and a translation needs
# to reorder the counts.

## 标签页与空状态

project-diagnostics = 项目诊断
buffer-diagnostics = 缓冲区诊断
no-problems = 没有问题
no-problems-in-workspace = 工作区中没有问题
no-errors-in-workspace = 工作区中没有错误

# 文件名紧跟在这句之后，作为一个可点击的按钮渲染。
no-problems-in = 以下文件没有问题：
no-errors-in = 以下文件没有错误：
show-1-warning = 显示 1 条警告
show-count-warnings = 显示 { $count } 条警告

## 工具栏

exclude-warnings = 排除警告
stop-diagnostics-update = 停止更新诊断
refresh-diagnostics = 刷新诊断

## 状态栏

expand-diagnostics = 展开诊断
next-diagnostic = 下一个诊断
project-diagnostics-no-problems = 项目诊断：没有问题
project-diagnostics-1-error = 项目诊断：1 个错误
project-diagnostics-errors-errors = 项目诊断：{ $errors } 个错误
project-diagnostics-1-warning = 项目诊断：1 个警告
project-diagnostics-warnings-warnings = 项目诊断：{ $warnings } 个警告
project-diagnostics-1-error-1-warning = 项目诊断：1 个错误，1 个警告
project-diagnostics-1-error-warnings-warnings = 项目诊断：1 个错误，{ $warnings } 个警告
project-diagnostics-errors-errors-1-warning = 项目诊断：{ $errors } 个错误，1 个警告
project-diagnostics-errors-errors-warnings-warnings = 项目诊断：{ $errors } 个错误，{ $warnings } 个警告
