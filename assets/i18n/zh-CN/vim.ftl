# Simplified Chinese (zh-CN) catalog for Vim mode's dialogs.
#
# Only Zed's own dialogs are localized. Vim's status line output stays in
# English on purpose — `-- INSERT --`, `[No Name]`, `[modified]`, the
# `"file" 120 lines --45%--` ruler and the register messages are part of the Vim
# emulation, and Vim users read them as such. Vim command names, marks and
# registers are likewise untouched.

argument-required = 需要参数
invalid-argument-argument = 无效参数：{ $argument }
no-file-name = 没有文件名
partial-buffer-write-requires-file-name = 写入部分缓冲区需要指定文件名。
use-to-write-partial-buffer = 使用 ! 写入部分缓冲区
overwriting-the-current-file-with-selected-buffer-content-requires = 用所选缓冲区的内容覆盖当前文件需要加 '!'。
path-already-exists-do-you-want-to-replace-it = { $path } 已存在，是否替换？
a-file-or-folder-with-the-same-name-already-exists-replacing-it-will-overwrite-its-current-contents = 已存在同名的文件或文件夹。替换将覆盖其当前内容。
